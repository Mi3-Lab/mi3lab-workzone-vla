+bool VisualBuilder::setupCosmos3EdgeViTProfile(
+    nvinfer1::IOptimizationProfile& profile, nvinfer1::INetworkDefinition const& network)
+{
+    constexpr char const* kCosmosVisualInput = "pixel_values";
+    auto* input = network.getInput(0);
+    if (input == nullptr || strcmp(input->getName(), kCosmosVisualInput) != 0)
+    {
+        LOG_ERROR("Cosmos3-Edge visual graph must expose input '%s'.", kCosmosVisualInput);
+        return false;
+    }
+
+    auto const dimensions = input->getDimensions();
+    if (dimensions.nbDims != 2 || dimensions.d[1] <= 0)
+    {
+        LOG_ERROR("Cosmos3-Edge visual input must have shape [patches, patch_dim].");
+        return false;
+    }
+    if (dimensions.d[0] >= 0)
+    {
+        auto const exact = createDims({dimensions.d[0], dimensions.d[1]});
+        return setOptimizationProfile(&profile, kCosmosVisualInput, exact, exact, exact);
+    }
+
+    int64_t const minPatches = mBuilderConfig.minImageTokens * 4;
+    int64_t const maxPatches = mBuilderConfig.maxImageTokens * 4;
+    int64_t const optPatches = (minPatches + maxPatches) / 2;
+    return setOptimizationProfile(&profile, kCosmosVisualInput, createDims({minPatches, dimensions.d[1]}),
+        createDims({optPatches, dimensions.d[1]}), createDims({maxPatches, dimensions.d[1]}));
+}
